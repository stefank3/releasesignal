BASE_URL=http://localhost:3000
TEST_EMAIL=your-test-email@example.com
TEST_PASSWORD=your-test-password
HEADLESS=false
# Legacy smoke/regression session IDs come from fixtures/sessions.json, not env vars.

# PR #60 live regression gate / Level 3 beta pre-deploy setup.
# Create these storage states with dedicated beta test accounts only.
# Do not commit real storage-state files, credentials, tokens, or secrets.
# Example values may be absolute paths or paths relative to /qa.
# PR60_TRIAL_AUTH_STATE=helpers/pr60-trial-auth.json
# PR60_ADMIN_AUTH_STATE=helpers/pr60-admin-auth.json
# PR60_SECOND_USER_AUTH_STATE=helpers/pr60-second-user-auth.json
# PR60_OWNER_SESSION_ID_WITH_ARTIFACTS=
# PR60_OWNER_UNIQUE_ARTIFACT_TEXT=

# Opt-ins for live flows that open Auth0 or consume AI/provider resources.
# PR60_ENABLE_AUTH0_ROUTE_SMOKE=true
# PR60_ENABLE_CREDIT_SPEND=true
# PR60_ENABLE_ADMIN_CHAT_CHECK=true

# PR10 is DISABLED by default. Do not enable until Stefan separately authorizes live work.
# Use a dedicated non-production HTTPS deployment and its matching read-only DB connection.
# BASE_URL=https://your-approved-preview.example
# PR10_ALLOWED_ORIGIN=https://your-approved-preview.example
# PR10_DATABASE_URL=postgresql://READ_ONLY_CONNECTION_FROM_SECRET_STORE
# PR10_INVENTORY=C:/private-pr10/inventory.json
# HEADLESS=false
# PR10_CREDIT_BUDGET=10  # Approved integer budget: 1-100; not an in-flight hard cap.
# PR10_ENABLE_LIVE=true
# PR10_ALLOW_PROVISIONING=true
# PR10_ALLOW_AI_SPEND=true
# PR10_ALLOW_EVIDENCE_WRITE=true
# PR10_ALLOW_ZERO_CHECK=true
# PR10_ALLOW_AUTH_FLOW=true
# Inventory and all six storage-state files must be outside this repository.
# See README for prerequisites, fixture schema, limitations, and separate PR6/PR8/PR9 runs.
# Fresh state: existing Auth0-only identity, BEFORE Start Trial, with no signup-intent cookie.
# PR10_INTERNAL_<ROLE>_STATE is generated by the harness; never configure it manually.
