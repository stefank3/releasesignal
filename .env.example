# Placeholder values only. Never commit real credentials or provider IDs.
# Copy this file to .env.local for local development and replace placeholders
# only in that ignored local file or in the environment provider's secret store.

# Runtime Postgres connection used by the application and Prisma commands.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Direct Postgres connection required by the current server environment contract.
DIRECT_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Auth0 server configuration.
AUTH0_DOMAIN=<auth0-tenant-domain>
AUTH0_CLIENT_ID=<auth0-client-id>
AUTH0_CLIENT_SECRET=<auth0-client-secret>
AUTH0_SECRET=<long-random-session-secret>
APP_BASE_URL=http://localhost:3000

# Upstash Redis server configuration.
UPSTASH_REDIS_REST_URL=<upstash-redis-rest-url>
UPSTASH_REDIS_REST_TOKEN=<upstash-redis-rest-token>

# OpenAI server configuration.
OPENAI_API_KEY=<openai-api-key>

# Optional server-side diagnostics. These are not product or billing authority.
ENABLE_VERBOSE_LOGS=false
LOG_INFO_SAMPLE_RATE=0.20
USD_TO_EUR=<positive-decimal-rate-or-leave-unset>

# NODE_ENV and VERCEL_ENV are runtime/platform-managed and should not be
# overridden to impersonate another deployment environment.
