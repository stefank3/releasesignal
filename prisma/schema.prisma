// prisma/schema.prisma
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: you likely have `url = env("DATABASE_URL")` in your real file.
}

model Organization {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now())
  members   OrgMember[]
  plans     Subscription[]
  wallets   CreditWallet[]
}

model OrgMember {
  id             String   @id @default(uuid())
  organizationId String
  auth0Sub       String
  role           String   // "admin" | "member"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, auth0Sub])
  @@index([auth0Sub])
}

model Subscription {
  id                 String   @id @default(uuid())
  organizationId     String
  status             String   // "active" | "past_due" | "canceled"
  planCode           String   // "office_50"
  seats              Int
  monthlyCredits     Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model CreditWallet {
  id             String   @id @default(uuid())
  organizationId String
  currency       String   // "credits"
  balance        Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledger       CreditLedger[]

  @@unique([organizationId, currency])
}

model CreditLedger {
  id        String   @id @default(uuid())
  walletId  String
  auth0Sub  String?
  delta     Int
  reason    String
  requestId String?   // IDP: used for idempotency of credit operations
  createdAt DateTime @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([requestId])

  // IDP: prevent duplicate ledger rows for the same operation
  @@unique([walletId, reason, requestId])
}

model ChatSession {
  id              String   @id @default(uuid())
  auth0Sub        String
  mode            String
  title           String?
  clientSessionId String?   // IDP: client-generated id to prevent duplicate sessions
  titleUpdatedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ==============================
  // CHANGE (M7.7): Session Artifact fields (Pinned requirement)
  // ==============================
  artifactJson     Json?     // Stores SessionArtifact (e.g., { refinedRequirement: {...} })
  artifactUpdatedAt DateTime? // When artifactJson last changed (NOT tied to updatedAt)
  // ==============================

  messages ChatMessage[]

  @@index([auth0Sub, updatedAt, id])

  // IDP: ensures one session per (user, clientSessionId).
  // NOTE: Postgres allows multiple NULLs, so this only enforces uniqueness when clientSessionId is set.
  @@unique([auth0Sub, clientSessionId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  auth0Sub  String
  role      String   // user | assistant | system
  content   String
  tokensIn  Int?
  tokensOut Int?
  requestId String?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // CURSOR: matches where { auth0Sub, sessionId } and ORDER BY createdAt DESC, id DESC
  @@index([auth0Sub, sessionId, createdAt, id])

  @@index([requestId])

  // IDP: prevent duplicate messages for the same request within a session
  // Allow one user + one assistant message per requestId within the same session
  @@unique([sessionId, requestId, role])
}