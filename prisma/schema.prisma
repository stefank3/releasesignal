// prisma/schema.prisma
// Prisma schema for Release Signal.
//
// M11 NOTE:
// This pass introduces the first telemetry persistence model:
// TelemetryEventLog
//
// Design rule:
// - telemetry is stored as structured events
// - telemetry is NOT derived from rendered chat text
// - telemetry stays append-only and analytics-friendly
//
// Prisma 7 compatible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())
  members   OrgMember[]
  plans     Subscription[]
  wallets   CreditWallet[]

  // M11:
  // Organization-level telemetry relation.
  // This allows internal analytics to group events by organization.
  telemetryEvents TelemetryEventLog[]
}

model OrgMember {
  id             String   @id @default(uuid())
  organizationId String
  auth0Sub       String
  role           String   // "admin" | "member"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, auth0Sub])
  @@index([auth0Sub])
}

model Subscription {
  id                 String   @id @default(uuid())
  organizationId     String
  status             String   // "active" | "past_due" | "canceled"
  planCode           String   // "office_50"
  seats              Int
  monthlyCredits     Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model CreditWallet {
  id             String   @id @default(uuid())
  organizationId String
  currency       String   // "credits"
  balance        Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledger       CreditLedger[]

  @@unique([organizationId, currency])
}

model CreditLedger {
  id        String   @id @default(uuid())
  walletId  String
  auth0Sub  String?
  delta     Int
  reason    String
  requestId String?   // IDP: used for idempotency of credit operations
  createdAt DateTime @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([requestId])

  // NOTE: Postgres allows multiple NULLs, so this only enforces uniqueness when requestId is set.
  @@unique([walletId, reason, requestId])
}

model ChatSession {
  id              String   @id @default(uuid())
  auth0Sub        String
  mode            String
  title           String?
  clientSessionId String?   // IDP: client-generated id to prevent duplicate sessions
  titleUpdatedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ==============================
  // Session Artifact (M7)
  // ==============================
  // Stores the SessionArtifact JSON contract for the session
  // (e.g. refined requirement, test suite, review result).
  // NOTE: Prisma Json is backed by Postgres JSONB under the hood.
  artifactJson Json?

  // App-managed timestamp:
  // - set ONLY when artifactJson changes
  // - do NOT rely on updatedAt (updatedAt changes for ANY session update)
  artifactUpdatedAt DateTime?
  // ==============================

  messages ChatMessage[]

  // M11:
  // Session-level telemetry relation.
  // Telemetry events are append-only and linked to the session when applicable.
  telemetryEvents TelemetryEventLog[]

  @@index([auth0Sub, updatedAt, id])

  // IDP: ensures one session per (user, clientSessionId).
  // NOTE: Postgres allows multiple NULLs, so this only enforces uniqueness when clientSessionId is set.
  @@unique([auth0Sub, clientSessionId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  auth0Sub  String
  role      String   // user | assistant | system
  content   String
  tokensIn  Int?
  tokensOut Int?
  requestId String?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // CURSOR: matches where { auth0Sub, sessionId } and ORDER BY createdAt DESC, id DESC
  @@index([auth0Sub, sessionId, createdAt, id])
  @@index([requestId])

  // IDP: prevent duplicate messages for the same request within a session
  // Allow one user + one assistant message per requestId within the same session
  @@unique([sessionId, requestId, role])
}

model TelemetryEventLog {
  id String @id @default(uuid())

  // Core event timestamp.
  // Keep this append-only for analytics and auditability.
  createdAt DateTime @default(now())

  // Event classification.
  // Examples:
  // - session_started
  // - requirement_refined
  // - test_suite_generated
  // - review_performed
  eventType String

  // Actor / ownership context.
  // auth0Sub remains nullable because some future internal/system events
  // may not be tied to an authenticated end user.
  auth0Sub       String?
  organizationId String?
  sessionId      String?

  // Workflow context.
  // Examples:
  // - strategy
  // - test_design
  // - test_review
  workflowStage String?

  // Execution outcome.
  // Examples:
  // - started
  // - success
  // - failed
  status String?

  // Performance metrics.
  // Store as Int milliseconds for efficient aggregation.
  durationMs Int?

  // Token metrics captured per operation.
  tokenInput  Int?
  tokenOutput Int?
  tokenTotal  Int?

  // Structured artifact linkage.
  // Examples:
  // - refinedRequirement
  // - testSuite
  // - reviewResult
  artifactType    String?
  artifactVersion Int?

  // Flexible structured metadata.
  // Examples:
  // {
  //   "suiteSize": 18,
  //   "newCasesGenerated": 18,
  //   "coverageScore": 82
  // }
  //
  // Keep this JSON field for event-specific details that do not justify
  // first-class columns in M11.
  metadataJson Json?

  // Optional relations.
  // We use nullable foreign keys because not every telemetry event will
  // belong to both an organization and a chat session.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  session      ChatSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // ==============================
  // Analytics indexes
  // ==============================
  // Time-based scans
  @@index([createdAt])

  // Event aggregation
  @@index([eventType, createdAt])

  // User-level usage analysis
  @@index([auth0Sub, createdAt])

  // Organization-level analytics
  @@index([organizationId, createdAt])

  // Session-level timeline reconstruction
  @@index([sessionId, createdAt])

  // Workflow KPI queries
  @@index([workflowStage, createdAt])

  // Outcome / reliability queries
  @@index([status, createdAt])
}